# Build Reviewer Agent Configuration
# Copy these into the project root .env (or export them in your shell)

# Anthropic API key (required) - https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Discord bot (required) - Developer Portal: New Application -> Bot ->
# enable MESSAGE CONTENT INTENT, then copy the token. Invite the bot with
# the "bot" AND "applications.commands" scopes. Right-click the channel
# (Developer Mode on) -> Copy Channel ID. One channel per build.
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CHANNEL_ID=your_channel_id_here

# Model override (default: claude-haiku-4-5-20251001)
# REVIEWER_MODEL_ID=claude-sonnet-4-5-20250929

# Safety-net review when commits land with no review for N minutes (default 60)
# SAFETY_REVIEW_MINUTES=60

# Agent Hub (optional) - sessions/metrics/registry land in ./.agent_hub,
# or in S3 when USE_S3=true
USE_S3=false
# AGENT_HUB_BUCKET=your-bucket-name
# AGENT_HUB_REGION=us-east-1
